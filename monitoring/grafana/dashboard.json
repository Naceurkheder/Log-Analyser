{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Scrape health and bounded API request rate.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up",
          "legendFormat": "{{service}} scrape",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, result, error_class) (rate(sentinel_http_requests_total[5m]))",
          "legendFormat": "{{service}} {{result}} {{error_class}}",
          "refId": "B"
        }
      ],
      "title": "System overview",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Pending depth, oldest item and dead-letter rate.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sentinel_worker_queue_depth{result=\"pending\"}",
          "legendFormat": "{{service}}/{{backend}} pending",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sentinel_queue_oldest_pending_seconds{service=\"producer\",result=\"pending\"}",
          "legendFormat": "oldest pending",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(sentinel_worker_dlq_total{result=\"dlq\"}[5m])",
          "legendFormat": "{{service}} DLQ/s",
          "refId": "C"
        }
      ],
      "title": "Queue health",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Heartbeat age and bounded job outcome rates.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 3,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "time() - sentinel_worker_heartbeat_timestamp_seconds{result=\"ok\"}",
          "legendFormat": "{{service}}/{{backend}} heartbeat age",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, backend, result) (rate(sentinel_worker_jobs_total[5m]))",
          "legendFormat": "{{service}}/{{backend}} {{result}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, backend, error_class) (rate(sentinel_worker_jobs_total{result=\"failure\"}[5m]))",
          "legendFormat": "{{service}} {{error_class}} failures",
          "refId": "C"
        }
      ],
      "title": "Worker health",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CUDA error rate, GPU job latency and device memory.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 4,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(sentinel_worker_cuda_errors_total{service=\"gpu-worker\",backend=\"gpu\"}[5m])",
          "legendFormat": "{{error_class}} CUDA errors",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service, backend) (rate(sentinel_worker_job_duration_seconds_bucket{backend=\"gpu\"}[5m])))",
          "legendFormat": "p95 {{service}}/{{backend}} job",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sentinel_worker_gpu_memory_bytes{result=\"used\"}",
          "legendFormat": "{{service}} VRAM used",
          "refId": "C"
        }
      ],
      "title": "GPU behavior",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Host/device memory ratios and durable outbox backlog.",
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sentinel_worker_memory_bytes{result=\"rss\"} / on (service, backend) group_left() sentinel_worker_memory_bytes{result=\"limit\"}",
          "legendFormat": "{{service}}/{{backend}} RAM ratio",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sentinel_worker_gpu_memory_bytes{result=\"used\"} / on (service, backend) group_left() sentinel_worker_gpu_memory_bytes{result=\"limit\"}",
          "legendFormat": "{{service}} VRAM ratio",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sentinel_worker_outbox_backlog{service=\"producer\",result=\"pending\"}",
          "legendFormat": "producer outbox",
          "refId": "C"
        }
      ],
      "title": "Resource usage",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": [
    "sentinel",
    "s7"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "utc",
  "title": "Sentinel-GPU fleet overview",
  "uid": "sentinel-overview",
  "version": 1,
  "weekStart": ""
}
