      "DatasetRef": {
        "additionalProperties": false,
        "description": "Immutable reference to a source object in the ``incoming`` bucket.",
        "examples": [
          {
            "bucket": "incoming",
            "encoding": "utf-8",
            "format": "text",
            "key": "datasets/2026-11-20/auth.log",
            "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
            "size_bytes": 1048576
          }
        ],
        "properties": {
          "bucket": {
            "default": "incoming",
            "maxLength": 63,
            "minLength": 1,
            "title": "Bucket",
            "type": "string"
          },
          "encoding": {
            "default": "utf-8",
            "enum": [
              "utf-8",
              "utf-8-sig",
              "latin-1"
            ],
            "title": "Encoding",
            "type": "string"
          },
          "format": {
            "const": "text",
            "default": "text",
            "title": "Format",
            "type": "string"
          },
          "key": {
            "maxLength": 1024,
            "minLength": 1,
            "title": "Key",
            "type": "string"
          },
          "sha256": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          },
          "size_bytes": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Size Bytes"
          }
        },
        "required": [
          "key"
        ],
        "title": "DatasetRef",
        "type": "object"
      },
      "DetectorConfig": {
        "additionalProperties": false,
        "description": "Bounded detector configuration hashed into every job id.",
        "examples": [
          {
            "baseline_windows": 10,
            "max_line_bytes": 65536,
            "rules": [
              {
                "pattern": "Failed password",
                "rule_id": "auth-failed-password",
                "severity": "high"
              },
              {
                "pattern": "HTTP/1.1\" 5",
                "rule_id": "http-5xx",
                "severity": "medium"
              }
            ],
            "window_seconds": 60,
            "z_threshold": 3.0
          }
        ],
        "properties": {
          "baseline_windows": {
            "default": 10,
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Baseline Windows",
            "type": "integer"
          },
          "max_line_bytes": {
            "default": 65536,
            "maximum": 1048576.0,
            "minimum": 256.0,
            "title": "Max Line Bytes",
            "type": "integer"
          },
          "rules": {
            "items": {
              "$ref": "#/components/schemas/DetectorRule"
            },
            "maxItems": 64,
            "minItems": 1,
            "title": "Rules",
            "type": "array"
          },
          "window_seconds": {
            "default": 60,
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Window Seconds",
            "type": "integer"
          },
          "z_threshold": {
            "default": 3.0,
            "exclusiveMinimum": 0.0,
            "maximum": 1000.0,
            "title": "Z Threshold",
            "type": "number"
          }
        },
        "required": [
          "rules"
        ],
        "title": "DetectorConfig",
        "type": "object"
      },
      "DetectorRule": {
        "additionalProperties": false,
        "description": "One stable pattern rule; ``rule_id`` is part of the run contract.",
        "properties": {
          "pattern": {
            "minLength": 1,
            "title": "Pattern",
            "type": "string"
          },
          "rule_id": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
            "title": "Rule Id",
            "type": "string"
          },
          "severity": {
            "default": "medium",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          }
        },
        "required": [
          "rule_id",
          "pattern"
        ],
        "title": "DetectorRule",
        "type": "object"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
