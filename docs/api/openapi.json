            "$ref": "#/components/schemas/DatasetRef"
          },
          "detector": {
            "$ref": "#/components/schemas/DetectorConfig"
          },
          "schema_version": {
            "const": 1,
            "default": 1,
            "title": "Schema Version",
            "type": "integer"
          }
        },
        "required": [
          "dataset",
          "detector"
        ],
        "title": "RunRequest",
        "type": "object"
      },
      "RunStatusResponse": {
