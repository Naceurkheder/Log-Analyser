            "type": "string"
          },
          "dataset": {
            "$ref": "#/components/schemas/DatasetRef"
          },
          "detector": {
            "$ref": "#/components/schemas/DetectorConfig"
          },
          "detector_config_hash": {
            "title": "Detector Config Hash",
            "type": "string"
          },
          "links": {
            "$ref": "#/components/schemas/Links"
          },
          "progress": {
            "$ref": "#/components/schemas/Progress"
          },
          "run_id": {
            "title": "Run Id",
