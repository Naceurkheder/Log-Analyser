      "RunRequest": {
        "additionalProperties": false,
        "description": "Control request for a new run (raw log contents are rejected).",
        "examples": [
          {
            "backend_policy": "gpu",
            "dataset": {
              "bucket": "incoming",
              "encoding": "utf-8",
              "format": "text",
              "key": "datasets/2026-11-20/auth.log",
              "sha256": "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08",
              "size_bytes": 1048576
            },
            "detector": {
              "baseline_windows": 10,
              "max_line_bytes": 65536,
              "rules": [
                {
                  "pattern": "Failed password",
                  "rule_id": "auth-failed-password",
                  "severity": "high"
                },
                {
                  "pattern": "HTTP/1.1\" 5",
                  "rule_id": "http-5xx",
                  "severity": "medium"
                }
              ],
              "window_seconds": 60,
              "z_threshold": 3.0
            },
            "schema_version": 1
          }
        ],
        "properties": {
          "backend_policy": {
            "default": "auto",
            "enum": [
              "gpu",
              "cpu",
              "auto"
            ],
            "title": "Backend Policy",
            "type": "string"
          },
