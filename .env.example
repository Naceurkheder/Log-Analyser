# Sentinel-GPU local environment
# Copy to .env and adjust if needed. Makefile reads values from here.

# LXD
LXD_PROJECT=sentinel
SENTINEL_NET=sentinel-net
SENTINEL_NET_CIDR=10.20.0.1/24

# Static container IPs (fleet layout lives in lxd/fleet.sh)
INFRA_IP=10.20.0.10
GPU_WORKER_IP=10.20.0.21
CPU_WORKER_IP=10.20.0.22
DASHBOARD_IP=10.20.0.23

# Emulated AWS (moto server inside the infra container)
AWS_ENDPOINT_URL=http://10.20.0.10:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Terraform (executed from the host; state kept out of git)
TF_DIR=terraform
