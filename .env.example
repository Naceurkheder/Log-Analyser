# Sentinel-GPU local environment
# Copy to .env and adjust if needed. Makefile reads values from here.

# LXD
LXD_PROJECT=sentinel
SENTINEL_NET=sentinel-net
SENTINEL_NET_CIDR=10.20.0.1/24

# Static container IPs (fleet layout lives in lxd/fleet.sh)
INFRA_IP=10.20.0.10
GPU_WORKER_IP=10.20.0.21
CPU_WORKER_IP=10.20.0.22
DASHBOARD_IP=10.20.0.23

# Emulated AWS (moto server inside the infra container)
AWS_ENDPOINT_URL=http://10.20.0.10:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Control API (Sprint 3)
# Local `make api` default; use http://10.20.0.11:8080 for the api container.
SENTINEL_API_URL=http://127.0.0.1:8000
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000
SENTINEL_RUNS_TABLE=SentinelRuns
SENTINEL_JOBS_TABLE=SentinelJobs
SENTINEL_ALERTS_TABLE=SentinelAlerts
SENTINEL_INCOMING_BUCKET=incoming
# Queue can be resolved by name (recommended) or pinned by URL.
SENTINEL_INGEST_QUEUE=ingest-queue
# SENTINEL_INGEST_QUEUE_URL=http://10.20.0.10:4566/000000000000/ingest-queue
SENTINEL_MAX_DATASET_BYTES=5368709120
SENTINEL_VERIFY_DATASET_OBJECT=1
SENTINEL_LOG_LEVEL=INFO

# Streaming producer (Sprint 3-B)
SENTINEL_RAW_CHUNKS_BUCKET=raw-chunks
SENTINEL_JOBS_GPU_QUEUE=jobs-gpu
SENTINEL_JOBS_CPU_QUEUE=jobs-cpu
# Optional URL pins; queue names are enough for moto.
# SENTINEL_JOBS_GPU_QUEUE_URL=http://10.20.0.10:4566/000000000000/jobs-gpu
# SENTINEL_JOBS_CPU_QUEUE_URL=http://10.20.0.10:4566/000000000000/jobs-cpu
SENTINEL_CHUNK_PREFIX=chunks
SENTINEL_CHUNK_TARGET_BYTES=16777216
SENTINEL_CHUNK_OVERSIZE_POLICY=reject
SENTINEL_PARSER_VERSION=sentinel-parser-v1
# backend_policy=auto resolves to this queue; artifact id is a versioned
# placeholder until Sprint 7 pins worker builds.
SENTINEL_AUTO_BACKEND=gpu
SENTINEL_JOB_ARTIFACT_ID=cpu-ref-v1

# Terraform (executed from the host; state kept out of git)
TF_DIR=terraform
